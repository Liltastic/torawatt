# Bu dosyayi .env olarak kopyala ve degeri kendi makinenin LAN IP'sine gore ayarla.
#
#   Windows: ipconfig  ->  "IPv4 Address"
#   macOS/Linux: ifconfig | grep "inet "
#
# server/ klasorunde `npm run dev` calisirken varsayilan port 4000'dir.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Harita stili icin Mapbox public token'in (pk. ile baslar). Mapbox hesabindan
# alinir: https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
