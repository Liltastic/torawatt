// TORA WATT backend - Prisma schema
//
// Postgres (Neon) kullanir - Render'in ucretsiz web servisinde disk kalici
// degil, SQLite dosyasi her deploy/restart'ta silinirdi. String[] yerine
// hala JSON-metin kullaniliyor (Station.amenities, Vehicle.connectors):
// SQLite'tan tasirken kod tarafinda (serialize.ts) degisiklik gerekmesin
// diye, ayrica ileride tekrar SQLite'a donulmesi gerekirse de calismaya
// devam eder.
//
// Sahiplik: her kayit bir "ownerId" tasir. Gercek auth (asagidaki User modeli)
// eklenmeden once bu, mobil uygulamanin SecureStore'da tuttugu kalici rastgele
// bir cihaz kimligiydi; artik gercek User.id. Deger duz bir String kaldi (FK
// degil) cunku gecis sirasinda hala cihaz kimligi tasiyan eski kayitlar olabilir -
// bunlar login/register aninda User.id'ye tasinir (bkz. routes/auth.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Station {
  id         String      @id
  name       String
  latitude   Float
  longitude  Float
  address    String
  operator   String
  isOpen24h  Boolean
  amenities  String // JSON string[] - SQLite'ta native dizi yok
  connectors Connector[]
  favorites  Favorite[]
}

model Connector {
  id            String  @id
  stationId     String
  station       Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  type          String // TYPE_2 | CCS2 | CHADEMO | NACS
  powerKw       Float
  status        String // AVAILABLE | OCCUPIED | FAULTED | OFFLINE | UNKNOWN
  pricePerKwh   Float?
  idleFeePerMin Float?

  @@index([stationId])
}

model Vehicle {
  id                            String   @id @default(cuid())
  ownerId                       String
  make                          String
  model                         String
  modelYear                     Int
  batteryCapacityKwh            Float
  maxAcKw                       Float
  maxDcKw                       Float
  connectors                    String // JSON string[] (ConnectorType[])
  averageConsumptionKwhPer100Km Float
  isActive                      Boolean  @default(false)
  createdAt                     DateTime @default(now())

  @@index([ownerId])
}

model Reservation {
  id              String   @id @default(cuid())
  ownerId         String
  stationId       String
  connectorId     String
  stationName     String
  connectorLabel  String
  startsAt        DateTime
  durationMinutes Int
  // PENDING | CONFIRMED | ARRIVED | CANCELLED
  // EXPIRED sunucuda saklanmiyor; bekleme suresi gectiginde istemci ve API
  // yaniti bunu turetiyor (bkz. src/lib/reservationStatus.ts).
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  @@index([ownerId])
}

model ChargingHistoryEntry {
  id              String   @id @default(cuid())
  ownerId         String
  stationId       String?
  stationName     String
  connectorLabel  String
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  energyKwh       Float
  pricePerKwh     Float
  cost            Float
  createdAt       DateTime @default(now())

  @@index([ownerId])
}

model Favorite {
  id        String   @id @default(cuid())
  ownerId   String
  stationId String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Ayni istasyon bir sahip icin en fazla bir kez favorilenir; PUT idempotent kalir.
  @@unique([ownerId, stationId])
  @@index([ownerId])
}

model SupportRequest {
  id        String   @id @default(cuid())
  ownerId   String
  message   String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  ownerId     String
  // DEMO veri: gercek kart numarasi hicbir zaman bu tabloya (ya da baska
  // hicbir yere) yazilmaz. PCI saglayicisi baglaninca bu model saglayicinin
  // dondurdugu token + maskelenmis alanlari tutacak sekilde genisleyecek.
  brand       String
  last4       String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ownerId])
}
